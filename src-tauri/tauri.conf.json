{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aria2-launcher",
  "version": "0.1.0",
  "identifier": "top.phro.aria2",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "aria2 启动器",
        "width": 860,
        "height": 620,
        "resizable": true,
        "center": true
      },
      {
        "label": "dropball",
        "url": "index.html?win=dropball",
        "title": "",
        "width": 150,
        "height": 134,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
